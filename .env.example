# ---------------------------------------------------------------------------
# Georgia Opportunity Ledger — environment template
#
# Every environment (development / staging / production) uses its OWN values for
# every key below. Never reuse a credential across environments, and never copy
# unsanitised production data into development (spec section 4).
# ---------------------------------------------------------------------------

# Public site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_ENVIRONMENT="development"   # development | staging | production

# --- Supabase -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-only. Bypasses row-level security — never expose to the browser and
# never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Stripe ---------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Price IDs are also stored on subscription_plans; these are the fallback used
# when seeding a fresh environment.
STRIPE_PRICE_WEEKLY_MONTHLY=""
STRIPE_PRICE_WEEKLY_ANNUAL=""
STRIPE_PRICE_DETAILED_MONTHLY=""
STRIPE_PRICE_DETAILED_ANNUAL=""
STRIPE_PRICE_PREMIUM_MONTHLY=""
STRIPE_PRICE_PREMIUM_ANNUAL=""

# --- Transactional email --------------------------------------------------
EMAIL_PROVIDER="resend"                  # resend | postmark | console
EMAIL_API_KEY=""
EMAIL_FROM="Georgia Opportunity Ledger <alerts@example.com>"
EMAIL_REPLY_TO="support@example.com"
# Signs one-click unsubscribe links (RFC 8058). Falls back to CRON_SECRET when
# unset, but give it its own value in production so rotating one does not
# invalidate every unsubscribe link already sitting in inboxes.
EMAIL_UNSUBSCRIBE_SECRET=""

# --- Background jobs ------------------------------------------------------
# Shared secret required by every /api/v1/jobs/* endpoint. Cron schedulers must
# send it as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=""

# --- Observability --------------------------------------------------------
SENTRY_DSN=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# --- Storage --------------------------------------------------------------
SUPABASE_STORAGE_BUCKET_REPORTS="reports"
SUPABASE_STORAGE_BUCKET_ATTACHMENTS="attachments"
SUPABASE_STORAGE_BUCKET_EXPORTS="exports"
MAX_UPLOAD_BYTES="26214400"              # 25 MiB

# Virus scanning for uploads (spec 20). With no URL set, files are stored
# with scan_status = skipped and a warning is logged in production. Point
# this at a ClamAV REST front end to turn scanning on; anything the scanner
# cannot clear stays hidden from members and is retried by scan-attachments.
FILE_SCANNER_PROVIDER="none"             # none | clamav
FILE_SCANNER_URL=""                      # e.g. http://clamav-rest:9000/scan
FILE_SCANNER_API_KEY=""
FILE_SCANNER_TIMEOUT_MS="20000"
